{
  "plugins": ["prettier-plugin-java"],
  "printWidth": 120,
  "tabWidth": 2,
  "singleQuote": true,
  "semi": false,
  "singleAttributePerLine": true,
  "htmlWhitespaceSensitivity": "ignore",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "*.java",
      "options": {
        "tabWidth": 4
      }
    }
  ]
}
